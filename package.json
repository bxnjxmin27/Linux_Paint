{
  "name": "paint-linux",
  "version": "0.1.0",
  "description": "A Windows 11 Paint recreation for Linux",
  "main": "./out/main/index.js",
  "author": {
    "name": "bxnjxmin27",
    "email": "bxnjxmin27@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "screenshot": "node scripts/screenshot.mjs",
    "dist": "electron-vite build && electron-builder --linux AppImage deb rpm",
    "dist:appimage": "electron-vite build && electron-builder --linux AppImage",
    "dist:deb": "electron-vite build && electron-builder --linux deb",
    "dist:rpm": "electron-vite build && electron-builder --linux rpm"
  },
  "dependencies": {},
  "devDependencies": {
    "@fluentui/react-icons": "^2.0.344",
    "@fontpkg/segoe-ui": "^5.67.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/utif": "^3.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "gifenc": "^1.0.3",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "utif": "^3.1.0",
    "vite": "^8.3.5",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.tanto.paint",
    "productName": "Paint",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "build/icon.png",
      "README.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "executableName": "paint",
      "synopsis": "Windows 11 Paint rebuilt for Linux",
      "description": "A Windows 11 Paint recreation for Linux, with layers, brushes, shapes, text, selection and transparency.",
      "desktop": {
        "entry": {
          "Name": "Paint",
          "Comment": "Draw and edit images",
          "Categories": "Graphics;2DGraphics;RasterGraphics;",
          "StartupWMClass": "paint"
        }
      },
      "mimeTypes": [
        "image/png",
        "image/jpeg",
        "image/bmp",
        "image/gif",
        "image/tiff",
        "image/webp"
      ],
      "maintainer": "bxnjxmin27 <bxnjxmin27@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Paint-${version}.${ext}"
    },
    "deb": {
      "artifactName": "paint_${version}_${arch}.${ext}"
    },
    "rpm": {
      "artifactName": "paint-${version}.${arch}.${ext}"
    }
  },
  "homepage": "https://github.com/bxnjxmin27/Linux_Paint",
  "desktopName": "paint",
  "repository": {
    "type": "git",
    "url": "https://github.com/bxnjxmin27/Linux_Paint.git"
  },
  "bugs": {
    "url": "https://github.com/bxnjxmin27/Linux_Paint/issues"
  }
}
